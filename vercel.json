{
  "rewrites": [
    {
      "source": "/api/disable-user",
      "destination": "/api/account?action=disable-user"
    },
    {
      "source": "/api/delete-user",
      "destination": "/api/account?action=delete-user"
    },
    {
      "source": "/api/anonymise-user",
      "destination": "/api/account?action=anonymise-user"
    },
    {
      "source": "/api/admin-issues",
      "destination": "/api/system?action=admin-issues"
    },
    {
      "source": "/api/system-test",
      "destination": "/api/system?action=system-test"
    },
    {
      "source": "/api/email-worker",
      "destination": "/api/system?action=email-worker"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://ascdypvchlbpfupsssuy.supabase.co https://images.unsplash.com https://placehold.co; connect-src 'self' https://ascdypvchlbpfupsssuy.supabase.co wss://ascdypvchlbpfupsssuy.supabase.co https://*.ingest.de.sentry.io https://challenges.cloudflare.com; frame-src 'self' https://drive.google.com https://*.substack.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logo-small.png|favicon.svg|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
